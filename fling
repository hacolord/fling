-- JJS Target Fling Script (Integrated with GUI Logic)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

_G.HubState = _G.HubState or {}
_G.HubLogic = _G.HubLogic or {}

_G.HubState.isFlingRunning = false

-- ==================== TÌM MỤC TIÊU GẦN NHẤT ====================
local function getClosestTarget()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local myPos = char.HumanoidRootPart.Position
    local closestTarget = nil
    local minDist = math.huge

    -- Quét người chơi khác
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local dist = (myPos - p.Character.HumanoidRootPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closestTarget = p.Character
                end
            end
        end
    end

    -- Quét NPC Dummy
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.lower(obj.Name) == "dummy" and obj ~= char then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if hrp and humanoid and humanoid.Health > 0 then
                local dist = (myPos - hrp.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    closestTarget = obj
                end
            end
        end
    end

    return closestTarget
end

-- ==================== FLING LOGIC ====================
local function doFlingOnce()
    local targetChar = getClosestTarget()
    if not targetChar then return false end

    local char = LocalPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    local myHumanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not myHrp then return false end

    local originalCFrame = myHrp.CFrame

    local targetParts = {}
    for _, part in pairs(targetChar:GetChildren()) do
        if part:IsA("BasePart") then
            table.insert(targetParts, part)
        end
    end

    if #targetParts == 0 then return false end

    -- Bật CanCollide = true trên nhân vật để đảm bảo sinh ra va chạm vật lý thực sự khi chạm vào kẻ thù
    local noclipConn = RunService.Stepped:Connect(function()
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                    part.CustomPhysicalProperties = PhysicalProperties.new(100, 100, 100, 100, 100)
                end
            end
        end
    end)

    local flingPower = _G.HubState.flingPower or 1000000000
    local flingVelocity = _G.HubState.flingVelocity or 1000000000
    local flingTime = _G.HubState.flingTime or 1

    local bav = Instance.new("BodyAngularVelocity")
    bav.Name = "MaxFlingRotator"
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(flingVelocity, flingVelocity, flingVelocity)
    bav.Parent = myHrp

    local startTime = tick()
    local done = false

    local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")

    local toggleVal = true
    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime >= flingTime or not targetChar or not targetChar.Parent or not _G.HubState.isFlingActive then
            heartbeatConn:Disconnect()
            noclipConn:Disconnect()
            if bav then bav:Destroy() end

            myHrp.AssemblyLinearVelocity = Vector3.zero
            myHrp.AssemblyAngularVelocity = Vector3.zero
            myHrp.CFrame = originalCFrame
            done = true
            return
        end

        -- Ép trạng thái Physics/Freefall liên tục để phá vỡ trạng thái đứng yên/bám đất của đối phương và bản thân
        if myHumanoid then
            myHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
        if targetHumanoid then
            targetHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
            targetHumanoid.Sit = false
        end

        toggleVal = not toggleVal
        local velVector = toggleVal and Vector3.new(flingPower, flingPower, flingPower) or Vector3.new(-flingPower, flingPower, -flingPower)

        for i = 1, #targetParts do
            local part = targetParts[i]
            if part and part.Parent then
                myHrp.CFrame = part.CFrame * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)) * CFrame.Angles(
                    math.rad(math.random(-180, 180)), 
                    math.rad(math.random(-180, 180)), 
                    math.rad(math.random(-180, 180))
                )
                
                -- Tạo va chạm trực tiếp với vận tốc góc/góc xoay siêu tốc để truyền động lượng sang mục tiêu
                myHrp.AssemblyLinearVelocity = velVector
                myHrp.Velocity = velVector
                myHrp.AssemblyAngularVelocity = Vector3.new(flingVelocity, flingVelocity, flingVelocity)
            end
        end
    end)

    while not done do
        task.wait()
    end

    -- Khôi phục vị trí ban đầu và khóa chặt bản thân đứng an toàn dưới đất
    if myHrp then
        myHrp.AssemblyLinearVelocity = Vector3.zero
        myHrp.AssemblyAngularVelocity = Vector3.zero
        myHrp.Velocity = Vector3.zero
        myHrp.CFrame = originalCFrame
    end

    return true
end

-- TỰ ĐỘNG LẶP LẠI FLING KHI MINIGUI FLING CÒN BẬT
_G.HubLogic.StartFlingLoop = function()
    if _G.HubState.isFlingRunning then return end
    _G.HubState.isFlingRunning = true

    task.spawn(function()
        while _G.HubState.isFlingActive do
            local success = doFlingOnce()
            if not success then
                task.wait(0.1)
            end
        end
        _G.HubState.isFlingRunning = false
    end)
end
